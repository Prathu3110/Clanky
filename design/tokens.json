{
  "$schema": "clanky-tokens/v1",
  "name": "Clanky · Pocket Handheld",
  "version": "0.1.0",
  "notes": "Accents live on marks, status lights, buttons and badges only, never on body text. Every text pair listed under contrast passes WCAG AA (4.5:1).",
  "color": {
    "base": {
      "oat": {
        "value": "#F3EBDD",
        "role": "Paper: bubbles, cards, light window surface (the one base neutral)"
      },
      "oat-2": {
        "value": "#E8DFCF",
        "role": "Sunken oat: wells, inputs, skeleton blocks, dividers on oat"
      },
      "ink": {
        "value": "#2A2420",
        "role": "Text and outlines (warm near-black); dark window surface"
      },
      "ink-2": {
        "value": "#3A322C",
        "role": "Raised dark surface: dark window panels, dark inputs"
      },
      "ink-3": {
        "value": "#4A4038",
        "role": "Dark hover / dark divider"
      },
      "ink-soft": {
        "value": "#5E5248",
        "role": "Secondary text on oat (6.39:1)"
      },
      "oat-soft": {
        "value": "#C9BDAD",
        "role": "Secondary text on ink / ink-2 (6.8:1 on ink-2)"
      }
    },
    "status": {
      "sky": {
        "value": "#A9CBE3",
        "role": "Listening",
        "on": "ink"
      },
      "butter": {
        "value": "#F6E3A1",
        "role": "Thinking",
        "on": "ink"
      },
      "tangerine": {
        "value": "#F2A65A",
        "role": "Working, attention, primary button",
        "on": "ink"
      },
      "sage": {
        "value": "#A8BFA0",
        "role": "Done, success",
        "on": "ink"
      },
      "rust": {
        "value": "#B5534A",
        "role": "Error, upset",
        "on": "#FFFFFF"
      },
      "rust-text": {
        "value": "#8E3A33",
        "role": "Error text on oat when a coloured word is needed (6.33:1)"
      }
    },
    "ghost": {
      "ghost-ivory": {
        "body": "#FAF4E6",
        "shade": "#D6C8B0",
        "rim": null,
        "glow": "#FFF1CF",
        "accent": "#F2A65A",
        "personality": "Look's own (Clanky)"
      },
      "ghost-cobalt": {
        "body": "#3468CE",
        "shade": "#244EA6",
        "rim": "#A9C2F5",
        "glow": "#5E8EF2",
        "accent": "#EDB53C",
        "jacket": "#1D1B2B",
        "personality": "Butler"
      },
      "ghost-green": {
        "body": "#30945F",
        "shade": "#207048",
        "rim": "#93DDB3",
        "glow": "#4FC987",
        "accent": "#EDB53C",
        "personality": "Teacher"
      },
      "ghost-pink": {
        "body": "#FF4F9A",
        "shade": "#D62E76",
        "rim": null,
        "glow": "#FF80B8",
        "accent": "#EDB53C",
        "scarf": "#F2A65A",
        "personality": "Sassy"
      },
      "ghost-gold": {
        "value": "#EDB53C",
        "role": "Shared trim: bow tie, tassel, sunglass rims, sparkles"
      },
      "glint": {
        "value": "#FFFFFF",
        "role": "Eye glints, shirt front, chalk, cloth"
      },
      "rim-rule": "On dark backgrounds the outline of Butler and Teacher swaps from ink to their rim colour, and their glow gets a third ring. Ivory and Sassy keep the ink outline."
    },
    "test-backgrounds": {
      "doc-white": "#FFFFFF",
      "app-dark": "#121014"
    }
  },
  "surface": {
    "overlay": {
      "fill": "oat",
      "stroke": "ink",
      "stroke-width": 1.5,
      "shadow": {
        "x": 0,
        "y": 2,
        "blur": 0,
        "color": "rgba(42,36,32,0.22)",
        "note": "Short, hard, handheld-style drop. Invisible on dark apps by design: the oat fill carries legibility there (15.98:1 against #121014)."
      },
      "dim-backdrop": {
        "color": "rgba(42,36,32,0.42)",
        "grid": {
          "dot": 1,
          "pitch": 4,
          "color": "rgba(243,235,221,0.10)"
        },
        "use": "Ask bar 'pause menu'"
      },
      "explain-scrim": {
        "light-app": "rgba(42,36,32,0.28)",
        "dark-app": "rgba(0,0,0,0.45)",
        "pick": "by sampled backdrop luminance (>= 0.18 uses light-app)",
        "spotlight": {
          "padding": 8,
          "radius": 8,
          "note": "Cut-out around the current target only; marks, bubble and ghost sit above the scrim at full opacity."
        },
        "in": "open 240ms",
        "out": "close 160ms",
        "reduced": "no fade, appears at full strength",
        "when": "Only during a guided explain or 'show me how'. Not for single quick answers or toasts.",
        "clicks": "Scrim passes clicks through to the app."
      }
    },
    "window-light": {
      "bg": "oat",
      "panel": "#FBF6EC",
      "well": "oat-2",
      "text": "ink",
      "text-2": "ink-soft",
      "divider": "oat-2",
      "focus": "tangerine"
    },
    "window-dark": {
      "bg": "ink",
      "panel": "ink-2",
      "well": "ink-3",
      "text": "oat",
      "text-2": "oat-soft",
      "divider": "ink-3",
      "focus": "tangerine"
    }
  },
  "contrast": {
    "ink on oat": 12.93,
    "ink-soft on oat": 6.39,
    "oat on ink": 12.93,
    "oat on ink-2": 10.61,
    "oat-soft on ink-2": 6.8,
    "ink on tangerine": 7.57,
    "ink on sky": 9.0,
    "ink on butter": 11.97,
    "ink on sage": 7.75,
    "white on rust": 4.88,
    "rust-text on oat": 6.33,
    "ink on oat-2": 11.58,
    "oat on app-dark": 15.98,
    "ink on doc-white": 15.31
  },
  "type": {
    "family": {
      "body": {
        "name": "Martian Mono",
        "stack": "'Martian Mono', ui-monospace, monospace",
        "use": "Body and UI"
      },
      "display": {
        "name": "Doto",
        "stack": "'Doto', 'Martian Mono', monospace",
        "use": "Headings, the character's name, small labels. Never paragraphs.",
        "weight": 800
      },
      "arabic": {
        "name": "Readex Pro",
        "stack": "'Readex Pro', 'Martian Mono', sans-serif",
        "use": "RTL replies. Set 1px larger than the Martian Mono step with the same line height (Martian's x-height is tall)."
      }
    },
    "numeric": "font-variant-numeric: tabular-nums (times, counts, progress)",
    "scale": {
      "label": {
        "family": "display",
        "size": 12,
        "line": 16,
        "weight": 800,
        "tracking": 0.06,
        "case": "upper"
      },
      "caption": {
        "family": "body",
        "size": 11,
        "line": 16,
        "weight": 400
      },
      "ui": {
        "family": "body",
        "size": 12,
        "line": 18,
        "weight": 500
      },
      "body": {
        "family": "body",
        "size": 13,
        "line": 20,
        "weight": 400
      },
      "bubble": {
        "family": "body",
        "size": 14,
        "line": 22,
        "weight": 400
      },
      "title": {
        "family": "body",
        "size": 15,
        "line": 22,
        "weight": 600
      },
      "display-s": {
        "family": "display",
        "size": 20,
        "line": 24,
        "weight": 800
      },
      "display-m": {
        "family": "display",
        "size": 28,
        "line": 32,
        "weight": 800
      },
      "display-l": {
        "family": "display",
        "size": 40,
        "line": 44,
        "weight": 900
      },
      "arabic-bubble": {
        "family": "arabic",
        "size": 15,
        "line": 24,
        "weight": 400
      }
    }
  },
  "shape": {
    "corner-style": "soft-square: small radii on everything, pixel motifs live in labels, dividers and the character",
    "radius": {
      "chip": 3,
      "control": 4,
      "bubble": 6,
      "card": 6,
      "toast": 6,
      "window": 10,
      "tab": 2
    },
    "bubble-tail": {
      "width": 12,
      "height": 8,
      "shape": "stepped (3 pixel steps of 4px)"
    },
    "accent-strip": {
      "height": 3,
      "where": "top inside edge of bubble; corner tab 12x12",
      "color": "active ghost body"
    }
  },
  "edge": {
    "stroke": {
      "overlay": 1.5,
      "window-control": 1,
      "focus-ring": 2,
      "focus-offset": 2
    },
    "divider": {
      "style": "dotted",
      "dot": 2,
      "gap": 2
    },
    "ghost-glow": {
      "normal": {
        "rings": [
          {
            "d": 1,
            "pattern": "checker",
            "alpha": 0.59
          },
          {
            "d": 2,
            "pattern": "1-in-4",
            "alpha": 0.35
          }
        ],
        "applies": [
          "ghost-ivory",
          "ghost-pink"
        ]
      },
      "strong": {
        "rings": [
          {
            "d": 1,
            "pattern": "solid",
            "alpha": 0.67
          },
          {
            "d": 2,
            "pattern": "checker",
            "alpha": 0.51
          },
          {
            "d": 3,
            "pattern": "1-in-4",
            "alpha": 0.31
          }
        ],
        "applies": [
          "ghost-cobalt",
          "ghost-green"
        ]
      },
      "only-on": "dark backgrounds (luminance of sampled backdrop < 0.18)"
    },
    "crt": {
      "where": "character face screen only",
      "glow-blur": 6,
      "glow-alpha": 0.35,
      "scanline": {
        "pitch": 2,
        "alpha": 0.06
      }
    },
    "dither": {
      "matrix": "Bayer 4x4",
      "values": [
        [
          0,
          8,
          2,
          10
        ],
        [
          12,
          4,
          14,
          6
        ],
        [
          3,
          11,
          1,
          9
        ],
        [
          15,
          7,
          13,
          5
        ]
      ],
      "use": "Transitions, skeleton shimmer, shading"
    }
  },
  "space": {
    "unit": 4,
    "scale": {
      "0": 0,
      "1": 2,
      "2": 4,
      "3": 8,
      "4": 12,
      "5": 16,
      "6": 24,
      "7": 32,
      "8": 48
    },
    "bubble-padding": [
      12,
      14
    ],
    "card-padding": 16,
    "window-padding": 24,
    "sprite-gap-to-bubble": 8
  },
  "motion": {
    "open": {
      "ms": 240,
      "ease": "cubic-bezier(0.2, 0.9, 0.3, 1)"
    },
    "close": {
      "ms": 160,
      "ease": "cubic-bezier(0.4, 0, 1, 1)"
    },
    "page": {
      "ms": 220,
      "ease": "cubic-bezier(0.3, 0.7, 0.2, 1)"
    },
    "pulse": {
      "ms": 1600,
      "loop": true,
      "ease": "steps(4)"
    },
    "stagger": {
      "ms": 40
    },
    "spring": {
      "stiffness": 420,
      "damping": 32,
      "mass": 1,
      "css-fallback": "cubic-bezier(0.34, 1.4, 0.64, 1) 260ms",
      "use": "presses, cursor glides"
    },
    "dither-wipe": {
      "ms": 200,
      "frames": 16,
      "note": "Bayer threshold steps for open/close of pixel surfaces"
    },
    "range": "All non-loop motion 150–400ms. Every animation is interruptible and never blocks input.",
    "reduced": "Fades only (open/close as 120ms opacity). Character shows frame 0 of its state plus its status bead; loops stop."
  },
  "sprite": {
    "cell": 32,
    "max-colours": 6,
    "sizes": {
      "default": "64px (2x)",
      "small": "32px (1x)",
      "cursor": "20px (10x10 at 2x)"
    },
    "sheets": "clanky-<ghost>-light.png / -dark.png, 4 columns x 16 state rows; timings in clanky-sprites.json"
  }
}